    "ProductUri": "urn:opcgateway:tool",
    "Port": 4840,
    "UseHostNameInEndpoint": true,
    "AllowNoSecurity": true,
    "EnableSecurity": false,
    "AutoAcceptClientCertificates": true,
    "MaxSessions": 100,
    "NamespaceUri": "urn:opcgateway:da",
    "RootFolderName": "Gateway",
    "MirrorDaHierarchy": true,
    "CertificateStoreRoot": "%CommonApplicationData%\\OPC Foundation\\CertificateStores"
  },
  "Tags": [
    { "ItemId": "Random.Int1", "Enabled": true, "AllowWrite": false },
    { "ItemId": "Random.Real4", "Enabled": true, "AllowWrite": false },
    { "ItemId": "Saw-toothed Waves.Int1", "Enabled": true, "AllowWrite": false },
    { "ItemId": "Square Waves.Real4", "Enabled": true, "AllowWrite": false },
    { "ItemId": "Triangle Waves.Real4", "Enabled": true, "AllowWrite": false }
  ],
  "Options": {
    "AutoStart": false,
    "UiRefreshIntervalMs": 250,
    "LogBufferSize": 2000,
    "ValueQueueCapacity": 100000,
    "BrowseChildLimit": 2000
  }
}

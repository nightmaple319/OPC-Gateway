{
  "DaSource": {
    "ProgId": "Matrikon.OPC.Simulation.1",
    "Host": "localhost",
    "UpdateRateMs": 1000,
    "PercentDeadband": 0.0,
    "ConnectTimeoutSeconds": 10,
    "ReconnectIntervalSeconds": 10,
    "HealthCheckIntervalSeconds": 5,
    "BranchSeparator": "."
  },
  "UaServer": {
    "ServerName": "OPC Gateway Server",

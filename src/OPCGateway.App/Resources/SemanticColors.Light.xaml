<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 方案 A「Fluent 藍」：沿用 WinUI 的語意色。小字對比皆 ≥ 4.5:1。正常狀態不上色，只有異常才用色。 -->
    <SolidColorBrush x:Key="StatusGoodBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="StatusGoodBackgroundBrush" Color="#DFF6DD" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusBadBackgroundBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#005FB7" />
    <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#E5F1FB" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#616161" />
    <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#F0F0F0" />
    <!-- 正常狀態的文字色（等於 WPF-UI 淺色的 TextFillColorPrimary），給轉換器用，切換主題時只改 Color -->
    <SolidColorBrush x:Key="StatusNormalBrush" Color="#E4000000" />

</ResourceDictionary>

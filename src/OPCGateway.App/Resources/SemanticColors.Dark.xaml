<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 方案 B「石墨青」：較淡、較低飽和的狀態色，對深色膠囊底的對比皆 ≥ 4.7:1。 -->
    <SolidColorBrush x:Key="StatusGoodBrush" Color="#81C784" />
    <SolidColorBrush x:Key="StatusGoodBackgroundBrush" Color="#1F3A2A" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FFB74D" />
    <SolidColorBrush x:Key="StatusWarningBackgroundBrush" Color="#3D2E12" />
    <SolidColorBrush x:Key="StatusBadBrush" Color="#E57373" />
    <SolidColorBrush x:Key="StatusBadBackgroundBrush" Color="#402224" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#64B5F6" />
    <SolidColorBrush x:Key="StatusInfoBackgroundBrush" Color="#17324A" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#9AA3AD" />
    <SolidColorBrush x:Key="StatusNeutralBackgroundBrush" Color="#2B3138" />
    <!-- 正常狀態的文字色（等於深色的 TextFillColorPrimary），給轉換器用，切換主題時只改 Color -->
    <SolidColorBrush x:Key="StatusNormalBrush" Color="#E6E8EB" />

</ResourceDictionary>

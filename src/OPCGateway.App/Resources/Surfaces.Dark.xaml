<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 方案 B「石墨青」的表面色：藍灰而非純黑，文字降到 #E6E8EB 減少刺眼。覆寫 WPF-UI 深色主題的對應資源。 -->
    <Color x:Key="ApplicationBackgroundColor">#1A1D21</Color>
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1A1D21" />

    <Color x:Key="CardBackgroundFillColorDefault">#23272D</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#23272D" />
    <Color x:Key="CardBackgroundFillColorSecondary">#2B3138</Color>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#2B3138" />
    <Color x:Key="CardStrokeColorDefault">#343A42</Color>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#343A42" />

    <Color x:Key="ControlFillColorDefault">#23272D</Color>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#23272D" />
    <Color x:Key="ControlFillColorSecondary">#2B3138</Color>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#2B3138" />
    <Color x:Key="ControlFillColorTertiary">#1F2328</Color>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#1F2328" />
    <Color x:Key="ControlStrokeColorDefault">#343A42</Color>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#343A42" />

    <Color x:Key="TextFillColorPrimary">#E6E8EB</Color>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E6E8EB" />
    <Color x:Key="TextFillColorSecondary">#9AA3AD</Color>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9AA3AD" />
    <Color x:Key="TextFillColorTertiary">#6F7883</Color>
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#6F7883" />

    <!-- 青色主色上的文字用深色，對比 8.3:1 -->
    <Color x:Key="TextOnAccentFillColorPrimary">#062A26</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#062A26" />
    <Color x:Key="TextOnAccentFillColorSecondary">#0B3B36</Color>
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#0B3B36" />

</ResourceDictionary>

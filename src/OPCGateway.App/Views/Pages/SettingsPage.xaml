<Page x:Class="OPCGateway.App.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:OPCGateway.App.ViewModels"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      Title="設定">

    <Page.Resources>
        <Style x:Key="Field" TargetType="ui:TextBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="ClearButtonEnabled" Value="False" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource FieldLabel}">
            <Setter Property="Margin" Value="0,0,12,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="Margin" Value="0,-6,0,10" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <ui:InfoBar Title="閘道運作中" Severity="Warning" IsClosable="False" Margin="0,0,0,8"
                        Message="OPC DA 與 OPC UA 的連線參數要重新啟動閘道後才會生效；標籤與自動啟動的變更則立即生效。"
                        IsOpen="{Binding IsRunning, Mode=OneWay}" />
            <ui:InfoBar Title="設定" IsClosable="True" Message="{Binding StatusMessage}" IsOpen="{Binding HasStatus, Mode=TwoWay}">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="Severity" Value="Success" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Severity" Value="Error" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>
            <ItemsControl ItemsSource="{Binding ValidationErrors}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="{DynamicResource StatusBadBrush}" FontSize="12" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== OPC DA ===== -->
                <StackPanel Grid.Column="0">
                    <ui:Card Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="PlugConnected24" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="OPC DA 來源" Style="{StaticResource SectionTitle}" Margin="0" />
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="伺服器 ProgID" Style="{StaticResource Label}" />
                                <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,10">
                                    <ui:Button DockPanel.Dock="Right" Content="掃描" Icon="{ui:SymbolIcon Search24}" Margin="8,0,0,0"
                                               Command="{Binding ScanServersCommand}" ToolTip="透過 OpcEnum 列舉主機上的 OPC DA 伺服器" />
                                    <ComboBox IsEditable="True" ItemsSource="{Binding AvailableServers}" DisplayMemberPath="ProgId"
                                              Text="{Binding Da.ProgId, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                </DockPanel>
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="例如 Matrikon.OPC.Simulation.1 或 Kepware.KEPServerEX.V6。掃描需要安裝 OPC Core Components。" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="主機" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.Host, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="更新頻率 (ms)" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.UpdateRateMs, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="死區 (%)" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.PercentDeadband, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="連線逾時 (秒)" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.ConnectTimeoutSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="重連間隔 (秒)" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.ReconnectIntervalSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="健康檢查 (秒)" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}"
                                            Text="{Binding Da.HealthCheckIntervalSeconds, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                                <TextBlock Grid.Row="8" Grid.Column="0" Text="階層分隔符號" Style="{StaticResource Label}" />
                                <ui:TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource Field}" MaxLength="4"
                                            Text="{Binding Da.BranchSeparator, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                                <TextBlock Grid.Row="9" Grid.Column="1" Style="{StaticResource Hint}"
                                           Text="用來把 ItemId 切成 UA 的資料夾階層，Matrikon 與 Kepware 用「.」。" />
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- ===== 一般 ===== -->
                    <ui:Card Padding="16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Settings24" FontSize="18" Margin="0,0,8,0" />
                                <TextBlock Text="一般" Style="{StaticResource SectionTitle}" Margin="0" />
                            </StackPanel>
                            <ui:ToggleSwitch Content="程式啟動時自動啟動閘道" IsChecked="{Binding AutoStart}" Margin="0,0,0,12" />
                            <TextBlock Text="外觀" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="Label"
                                      Width="220" HorizontalAlignment="Left" Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                                       Text="淺色為 Fluent 藍（Windows 語意色），深色為石墨青（監控室用）。切換立即生效，也可用上方命令列的月亮／太陽鈕快速切換。" />
                            <TextBlock Text="設定檔位置" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                            <DockPanel Margin="0,0,0,12">
                                <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon FolderOpen24}" Margin="8,0,0,0"
                                           Command="{Binding OpenConfigFolderCommand}" ToolTip="開啟設定資料夾" />
                                <TextBlock Text="{Binding ConfigPath}" Style="{StaticResource MonoText}" FontSize="11"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding ConfigPath}" />
                            </DockPanel>
                            <StackPanel Orientation="Horizontal">
                                <ui:Button Content="匯入設定…" Icon="{ui:SymbolIcon ArrowDownload24}" Command="{Binding ImportCommand}" />
                                <ui:Button Content="匯出設定…" Icon="{ui:SymbolIcon ArrowUpload24}" Command="{Binding ExportCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ui:Card>
                </StackPanel>

                <!-- ===== OPC UA ===== -->
                <ui:Card Grid.Column="2" Padding="16" VerticalAlignment="Top">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <ui:SymbolIcon Symbol="Server24" FontSize="18" Margin="0,0,8,0" />
                            <TextBlock Text="OPC UA 伺服器" Style="{StaticResource SectionTitle}" Margin="0" />
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="伺服器名稱" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="0" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.ServerName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="應用程式名稱" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.ApplicationName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Application URI" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.ApplicationUri, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="連接埠" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.Port, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}">
                                <Run Text="端點預覽：" /><Run Text="{Binding EndpointPreview, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" />
                            </TextBlock>

                            <TextBlock Grid.Row="5" Grid.Column="0" Text="最大工作階段" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.MaxSessions, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="根資料夾" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.RootFolderName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="命名空間 URI" Style="{StaticResource Label}" />
                            <ui:TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}"
                                        Text="{Binding Ua.NamespaceUri, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        </Grid>

                        <Separator Margin="0,4,0,12" />

                        <ui:ToggleSwitch Content="以主機名稱作為端點（否則列舉每個 IPv4 位址）" IsChecked="{Binding Ua.UseHostNameInEndpoint}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Content="依 DA 階層建立子資料夾" IsChecked="{Binding Ua.MirrorDaHierarchy}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Content="保留無安全性端點（None / 匿名）" IsChecked="{Binding Ua.AllowNoSecurity}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Content="啟用安全端點（Basic256Sha256 Sign / SignAndEncrypt）" IsChecked="{Binding Ua.EnableSecurity}" Margin="0,0,0,8" />
                        <ui:ToggleSwitch Content="自動信任未知的客戶端憑證" IsChecked="{Binding Ua.AutoAcceptClientCertificates}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                   Text="生產環境建議關閉自動信任，並在 %ProgramData%\OPC Foundation\CertificateStores\UA Applications 手動放入客戶端憑證。" />
                    </StackPanel>
                </ui:Card>
            </Grid>
        </ScrollViewer>

        <!-- ===== 動作列 ===== -->
        <DockPanel Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <ui:Button Content="還原" Command="{Binding RevertCommand}" Margin="0,0,8,0" />
                <ui:Button Content="套用並儲存" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Command="{Binding ApplyCommand}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,8,0" />
                <TextBlock Text="處理中…" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Page>
